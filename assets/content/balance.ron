// Global balance knobs (Balance Analyst). See cp_content::Balance; a missing field keeps its default.
Balance((
    // Trips shorter than this straight-line distance are walked (system-design §9.2).
    walk_limit_m: 300.0,
    // T-242: seconds before a car trip moves (to the car, parking); a citizen with a car walks when
    // the real walking route takes less than the drive plus this. // tune later
    car_start_penalty_s: 90.0,
    // T-280: share of car trips that put a car on the road; the rest run abstractly (their
    // route's travel time, no lane taken), as a trip with the vehicle pool full. 0.15, not 0.25:
    // emptier roads turn walks into drives, 0.15 gives ~4x fewer cars. The same for goods
    // trucks; service vehicles always drive.
    car_visible_share: 0.15,
    truck_visible_share: 0.25,
    // BUG-101: tourists too (919 tourist cars stood at one entry): the hidden ones travel by
    // their route's time and still visit and pay. And at most this many cars wait to enter at
    // one spawn lane of the entry; later runs from outside go by their travel time.
    tourist_visible_share: 0.15,
    spawn_queue_cap: 40,
    // BUG-097: bulldozing gives back this share of what the player paid (placed buildings, road
    // length, pipes and power lines, bus stops); grown buildings give nothing.
    demolish_refund: 0.7,
    // A spawn attempt on a zone block proceeds with probability 1 / spawn_one_in (§8).
    spawn_one_in: 4,

    // --- Demand (system-design §11), recomputed every 64 ticks ---
    // Share of the gap to the raw value closed per recomputation (the EMA).
    demand_ema: 0.25,
    // Added to raw R, C, I, O: what an empty city wants.
    demand_base: (10.0, 5.0, 5.0, 0.0),
    // Weight of a free job slot of education 0..3 in R.
    demand_job_weight: (1.0, 1.0, 1.5, 2.0),
    // A vacant home counts this many adults against R.
    demand_adults_per_home: 2.0,
    // Commercial job slots supported per resident (C). BUG-099: 0.3 (was 0.2): with 0.2 and 0.5
    // below a town had 0.3 jobs per resident against ~0.7 adults; the jobless within the commuter
    // allowance asked for none, R waited for free jobs, and a new game stalled at ~2000 residents
    // with 23 % unemployed (T-293 playtest).
    demand_shop_jobs_per_citizen: 0.3,
    // Industrial job slots needed per commercial job slot (I). BUG-099: 0.8 (was 0.5) =
    // goods_per_job / goods_per_worker: at the ratio the town's industry makes the goods its shops
    // sell (BUG-095).
    demand_industry_jobs_per_shop_job: 0.8,

    // --- Land value, pollution, noise (system-design §11), recomputed every 256 ticks ---
    // Pollution and noise of the buildings without `emits` of their own (T-300, §11.1): strength
    // 0..100, radius in 8 m zone cells. Industry by resource: Farming, Forestry, Ore, Oil. Shop
    // radii: (ComHigh, ComLow). Only highways make road noise. The ground takes the rise days to
    // reach a source and the decay days to lose 100 after it.
    pollution_industry: 50.0,
    pollution_industry_res: (30.0, 30.0, 70.0, 80.0),
    pollution_radius_cells: 8.0,
    pollution_oil_radius_cells: 12.0,
    noise_industry: 60.0,
    noise_com_high: 35.0,
    noise_com_low: 20.0,
    noise_radius_cells: 8.0,
    noise_com_radius_cells: (6.0, 5.0),
    noise_highway_per_load: 60.0,
    noise_highway_radius_cells: 6.0,
    emit_level_step: 0.15,
    pollution_rise_days: 3.0,
    pollution_decay_days: 10.0,
    // Land value 0..100 = base + road access + water + power - weighted pollution and noise.
    land_base: 20.0,
    land_access: 30.0,
    land_water: 10.0,
    land_power: 10.0,
    land_utility_reach_m: 64.0,
    land_pollution_weight: 0.6,
    land_noise_weight: 0.4,

    // --- Levels (system-design §8) ---
    // Land value needed for residential levels 1..5 and commercial levels 1..3.
    level_res_land: (0.0, 30.0, 45.0, 55.0, 65.0),
    level_com_land: (0.0, 40.0, 55.0),
    // Average worker education needed for industrial and office levels 1..3.
    level_ind_edu: (0.0, 0.7, 1.5),
    level_office_edu: (0.0, 1.5, 2.3),
    // Consecutive level checks (every 256 ticks, 8 a day since T-301; 6 = 3/4 of a day, as 3 of 16 were) that move a building one level.
    level_checks: 6,

    // --- Decay (system-design §8) ---
    // Days of an unbroken problem until abandoned, and until demolished (from the first problem).
    abandon_days: 35.0,
    demolish_days: 70.0,
    // Flags that count towards abandonment (bits: 1 water, 2 power, 4 workers, 8 customers,
    // 16 goods, 32 sewage, 64 road, 128 path). 251 = all but no-workers. // tune later
    decay_mask: 251,
    // NO_WORKERS: filled jobs below this share of the slots for this many days. // tune later
    no_workers_ratio: 0.5,
    no_workers_days: 15.0,

    // --- Tax (system-design §16 M2 A): weekly, at a 100% rate; the city rate scales it ---
    // T-282: taxes x5 (was 528..860 and 108/81/117/162): x1 became 2x slower, and a 700 town now earns a basic service in ~2 game days.
    // Per household living in a residential building of level 1..5. BUG-061: x2 for levels 1-2 (was 264, 336). T-244: levels 3-5 raised so a level-up never pays less (was 420, 516, 624).
    tax_household: (860.0, 1090.0, 1140.0, 1270.0, 1400.0),
    // Per filled job of education 0..3. // tune later
    tax_job: (175.0, 131.0, 190.0, 263.0),
    // Multiplier of tax_job by building level 1..3. T-244: 1.2/1.45 -> 1.15/1.35 to offset the household tax of levels 3-5.
    level_mul: (1.0, 1.15, 1.35),

    // --- Loans (system-design §16 M2) ---
    // The bank's offers; simple interest for the whole term, equal weekly payments, one active
    // loan per offer, paying off early costs only the principal left. // tune later
    loan_offers: [
        (amount: 25000.0, interest_pct: 3.0, weeks: 26, min_population: 0),
        (amount: 60000.0, interest_pct: 4.0, weeks: 52, min_population: 1000),
        (amount: 150000.0, interest_pct: 5.0, weeks: 104, min_population: 5000),
    ],

    // --- Tiles (system-design §16 M2): price of buying a tile by ring (distance from the start tile) 1..4 // tune later ---
    tile_price: (5000.0, 10000.0, 20000.0, 40000.0),
    // The treasury of a new game (BUG-061, was 70 000: covers the first needs). // tune later
    start_money: 150000.0,

    // --- Garbage (system-design §16 M2 D): per game day, collected by landfills and incinerators ---
    // Per household and per filled job; a building from garbage_problem up has the GARBAGE problem. // tune later
    garbage_household: 4.0,
    garbage_job: 1.0,
    garbage_problem: 200.0,
    // A building holding this much garbage gets a garbage truck (T-151). // tune later
    garbage_truck_min: 20.0,

    // --- Fire (system-design §16 M2 D): all // tune later ---
    // Chance per building and game day without cover; cover removes up to fire_cover of it.
    fire_base: 0.0008,
    fire_cover: 0.8,
    // Hours an engine works at the fire; hours until an unattended fire burns the building down;
    // days a burned building stands before demolition.
    fire_extinguish_hours: 2.0,
    fire_burn_hours: 12.0,
    burned_days: 2.0,
    // Chance per game hour that a burning building ignites a neighbour within fire_spread_m.
    fire_spread: 0.03,
    fire_spread_m: 12.0,
    // Engine speed on the road, km/h.
    fire_engine_kmh: 50.0,

    // --- Police (system-design §16 M2 D): all // tune later ---
    // Crime per building and game day without cover on land worth 100; cover removes up to
    // police_cover of it; cheap land adds up to crime_poor times more; CRIME from crime_problem up.
    crime_base: 4.0,
    police_cover: 0.9,
    crime_poor: 1.0,
    crime_problem: 100.0,

    // --- Lifecycle (system-design §16 M2 D): all // tune later ---
    // Chance per game day to die by age: (age in years, chance) points, linear between them,
    // 0 before the first, flat after the last.
    death_curve: [(50.0, 0.0), (60.0, 0.002), (70.0, 0.006), (80.0, 0.02), (90.0, 0.06), (100.0, 0.2)],
    // Days of sickness after which the sick can die, and their chance per game day.
    sick_death_days: 35.0,
    sick_death_chance: 0.1,
    // Chance per game day that a household of two adults aged 20-40 with a free place has a child.
    birth_chance: 0.02,

    // --- Health (system-design §16 M2 D): all // tune later ---
    // Chance per game day to fall ill, plus this much per point (0..100) of pollution at the home.
    sick_base: 0.003,
    sick_pollution: 0.0003,
    sick_noise: 0.0001,
    sick_water: 0.0003,
    bad_water_at: 10.0,

    // --- Service effects (system-design §16 M2 D "Эффекты"): all // tune later ---
    // Land value a full coverage of Health, Police, Fire, Education adds to a cell.
    land_service: (8.0, 6.0, 4.0, 8.0),
    // Land value a building with GARBAGE / CRIME takes from its cell.
    land_garbage: 8.0,
    land_crime: 10.0,
    // T-290: a garbage facility upsets the homes within garbage_nuisance_m (8 cells) of its footprint:
    // the land loses up to land_nuisance_garbage at the footprint, falling to 0 at that distance.
    // Industry, shops and offices do not feel it (the 'fine next to the industrial zone' case).
    garbage_nuisance_m: 64.0,
    land_nuisance_garbage: 24.0,
    // A home of level 1..5 needs this many of Health, Police, Fire, Education covered at least
    // res_service_cover.
    res_level_services: (0, 0, 1, 2, 4),
    res_service_cover: 0.3,
    // Service problems that count towards abandonment: GARBAGE (1) and DEAD (4).
    decay_service_mask: 5,

    // --- Transit (system-design §16 M3 A): all // tune later ---
    // Price of one bus stop, currency units.
    bus_stop_cost: 500.0,
    // Seconds a bus stands at a stop, and the weekly upkeep of a bus out on a line.
    dwell_s: 10.0,
    bus_upkeep_week: 120.0,
    // Riders (T-159): stop reach from a trip's ends, penalty per ride, car bias, assumed car
    // speed (m/s), longest wait before the trip goes on abstractly, fare per boarding.
    transit_walk_m: 600.0,
    transit_penalty_s: 120.0,
    car_bias: 1.0,
    car_speed_est: 9.0,
    max_wait_s: 900.0,
    transit_fare: 2.0,
    // Metro (T-163): weekly upkeep of a train out on a line, price of a boarding, seconds a
    // train needs to turn round at a terminus.
    metro_upkeep_week: 400.0,
    metro_fare: 3.0,
    metro_turn_s: 30.0,
    // Changes (T-165): walk between two stops of different lines, extra penalty of a trip with
    // a change, most lines looked at either end of a trip.
    transfer_walk_m: 150.0,
    transfer_penalty_s: 60.0,
    transit_lines_cap: 8,
    // Tourists (T-168) // tune later: visits a day with no shops and per commercial building,
    // hours a visit lasts, money per visit, largest share of the vehicle pool they may hold,
    // metres from the entry at which a shop is half as likely a goal.
    tourism_base: 4.0,
    tourism_per_com: 1.5,
    tourism_visit_h: 2.0,
    tourism_income: 12.0,
    tourism_pool_share: 0.1,
    tourism_reach_m: 1500.0,
    // Heavy traffic ban (T-195) // tune later: A* cost multiplier of a banned district's lanes for trucks.
    heavy_ban_cost_mul: 8.0,
    // District specialisations (T-196) // tune later: buildings a district rebuilds a day after its specialisation changes.
    respec_per_day: 4,
    // Block fit (T-185) // tune later: metres by which a nearly 8 x 8 cell block (or a side that is
    // nearly whole cells long) is fitted to whole cells by stretching or shrinking them.
    zoning_block_fit_m: 6.0,
    // Goods (T-169) // tune later: units made a day per filled industrial job, sold a day per
    // filled shop job, most stored, one truck's load, metres a factory looks for a shop, days
    // without stock before NO_GOODS, and whether NO_GOODS counts towards abandonment.
    goods_per_worker: 0.5,
    goods_per_job: 0.4,
    goods_stock_cap: 100.0,
    goods_truck_load: 20.0,
    freight_radius_m: 1500.0,
    // Outside trade (T-170) // tune later: money per exported unit; a shop with no factory in
    // reach imports a truck when its stock is below this.
    export_price: 10.0,
    goods_import_threshold: 5.0,
    goods_empty_days: 2.0,
    goods_decay: false,
    // Intercity trains (T-167) // tune later: hours between trains from the outside, hours a
    // train stands at the station, percent of arriving households that come by train (with a
    // station on the railway), tourists a train brings.
    intercity_interval_h: 6.0,
    intercity_dwell_h: 0.5,
    move_in_by_train: 40,
    tourism_by_train: 8,
    // Resource deposits (T-205) // tune later: ore and oil in one 64 m cell at richness 1.
    deposit_per_cell: 20000.0,
    // An extractor's lot needs this average richness (T-208) // tune later.
    min_richness: 0.3,
    // Park areas (T-223) // tune later: attractiveness share each level above 1 adds.
    park_attract_per_level: 0.1,
    // Leisure and visitors (T-224) // tune later.
    leisure_from: 10.0,
    leisure_to: 20.0,
    leisure_chance_per_day: 0.3,
    leisure_dist_m: 1500.0,
    leisure_visit_h: 3.0,
    walkers_per_park: 6,
    tourist_leisure_share: 0.3,
    park_fee_max: 20.0,
    // T-244: a new park area starts with this fee, so a park with a gate and two attractions covers its upkeep from level 2.
    park_fee_default: 3.0,
    // Park levels (T-225) // tune later: visitors for levels 2 to 5, land value per level, reach.
    park_levels: (150, 600, 2000, 5000),
    park_land: (2.0, 5.0, 9.0, 14.0, 20.0),
    park_land_radius_m: 200.0,
    // Goods of a unique factory sell for this many times the usual export price (T-215) // tune later.
    factory_export_mul: 4.0,
    // Cargo trains (T-216): hours between two trains at a cargo station and the units one takes. // tune later
    cargo_train_interval_h: 12.0,
    cargo_train_capacity: 1200.0,
    // Cargo ships (T-217): hours between two ships, hours at the berth, units one takes. // tune later
    ship_interval_h: 24.0,
    ship_dwell_h: 6.0,
    ship_capacity: 4000.0,
    // Hours a cargo train stands at its station; hours a ship sails in and out (T-216b, T-217). // tune later
    cargo_train_dwell_h: 1.0,
    ship_sail_h: 1.0,
    // --- Mail (T-247): per game day, collected by post offices and sorted by them and the sorting facility ---
    // Per household and per filled job (shops and offices make it times the factors); a building holding
    // mail_van_min gets a van, from mail_problem up it has the MAIL problem. // tune later
    mail_household: 1.0,
    mail_job: 0.3,
    mail_commercial_mul: 2.0,
    mail_office_mul: 4.0,
    mail_van_min: 30.0,
    mail_problem: 80.0,
    // A post office sorts this much a day itself; collecting stops when the unsorted mail is over
    // mail_backlog_days days of the city's sorting capacity.
    mail_post_sort: 300.0,
    mail_backlog_days: 2.0,
    // Land value a MAIL building takes from its cell, shops and offices land_mail_work more.
    land_mail: 3.0,
    land_mail_work: 4.0,
    // Area levels (T-209) // tune later: xp for levels 2 to 5, storage share per level above 1.
    industry_levels: (2000, 8000, 25000, 60000),
    industry_storage_per_level: 0.1,

    // --- Networks (T-181): distances of water, sewage and power // tune later ---
    // power_gap_m: largest gap between the footprint edges of two buildings over which one
    //   passes power on to the other. line_reach_m / pipe_reach_m: how far a building's edge may
    //   be from a power line / pipe. Tool hints, reach circles and overlays read the same values.
    networks: (
        power_gap_m: 64.0,
        line_reach_m: 80.0,
        pipe_reach_m: 64.0,
    ),
))
