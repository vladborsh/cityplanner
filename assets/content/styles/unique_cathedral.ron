Style((
    id: "unique_cathedral",
    massing: Cathedral,
    roof: Flat,
    floors: (1, 1),
    footprint_fill: (1.0, 1.0),
    palette: (
        walls: [(0.8, 0.74, 0.62)],
        roof: [(0.3, 0.34, 0.4)],
        trim: [(0.9, 0.84, 0.7)],
        glass: (0.5, 0.38, 0.7),
    ),
    facade: Punched,
))
