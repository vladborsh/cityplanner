// Population milestones (T-149, design §16 M2). Reaching one unlocks buildings and adds `tiles` to the number of tiles
// the player may buy (owned < 1 + the sum over the milestones reached). The numbers are first guesses: tune later.
Milestones((
    milestones: [
        (population: 0, name: "Village", unlocks: [], tiles: 2),
        (population: 500, name: "Small town", unlocks: ["clinic", "elementary_school", "fire_station", "police_station", "landfill"], tiles: 3),
        (population: 2000, name: "Town", unlocks: ["high_school", "cemetery", "crematorium", "incinerator", "post_office"], tiles: 4),
        (population: 5000, name: "Large town", unlocks: ["hospital", "post_sorting_facility"], zones: [ResHigh, ComHigh, Office], tiles: 5),
        (population: 10000, name: "Small city", unlocks: ["university"], tiles: 6),
    ],
))
