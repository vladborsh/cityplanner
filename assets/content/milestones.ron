// Population milestones (T-149, T-283; design §16 M2). Reaching one unlocks buildings, zones and policies and adds `tiles`
// to the number of tiles the player may buy (owned < 1 + the sum over the milestones reached). What no milestone names is
// open from the start (roads and utility tools, the growing houses); the unique buildings (cathedral, clock tower, ...)
// also keep their own unlock conditions. On a map with no water body the player can clean sewage from the start:
// the treatment plant and the water tower are at Hamlet. Tiles: 2 at Hamlet, 1 at every later milestone (13 in all).
Milestones((
    milestones: [
        (population: 0, name: "Hamlet", unlocks: ["wind_turbine", "coal_power_plant", "water_pump_station", "sewage_outflow_station", "sewage_treatment_plant", "water_tower", "small_park", "prop_bench", "prop_flowerbed", "prop_kiosk", "prop_lamp", "prop_statue", "prop_tree_cluster"], zones: [ResLow, ComLow, Industrial], policies: [PowerSaving], tiles: 2),
        (population: 300, name: "Village", unlocks: ["police_station", "fire_station", "clinic", "landfill"], policies: [SmokeDetectors], tiles: 1),
        (population: 700, name: "Large Village", unlocks: ["elementary_school", "cemetery", "playground", "sports_field"], policies: [NeighborhoodWatch, Recycling], tiles: 1),
        (population: 1500, name: "Small Town", unlocks: ["high_school", "bus_depot", "post_office", "plaza_fountain", "water_reservoir"], policies: [TransparentTenders, EncourageBiking], tiles: 1),
        (population: 3000, name: "Town", unlocks: ["crematorium", "incinerator", "cargo_station", "train_station", "tram_depot", "trolley_depot", "water_pump_large", "gas_power_plant"], policies: [HeavyTrafficBan, FreeTransit], tiles: 1),
        (population: 5000, name: "Busy Town", unlocks: ["hospital", "post_sorting_facility", "sewage_treatment_large", "wind_farm"], zones: [ResHigh, ComHigh, Office], policies: [HighRiseBan], tiles: 1),
        (population: 8000, name: "Big Town", unlocks: ["metro_station", "farm_extractor_l", "farm_extractor_s", "farm_main", "farm_processor_a", "farm_processor_b", "farm_warehouse", "forest_extractor_l", "forest_extractor_s", "forest_main", "forest_processor_a", "forest_processor_b", "forest_warehouse", "oil_extractor_l", "oil_extractor_s", "oil_main", "oil_processor_a", "oil_processor_b", "oil_warehouse", "ore_extractor_l", "ore_extractor_s", "ore_main", "ore_processor_a", "ore_processor_b", "ore_warehouse", "car_factory", "electronics_factory", "food_factory", "furniture_factory"], tiles: 1),
        (population: 12000, name: "Small City", unlocks: ["university", "cargo_port", "city_park_gate", "zoo_gate", "nature_gate", "amusement_gate", "city_park_attr_1", "city_park_attr_2", "city_park_attr_3", "city_park_attr_4", "zoo_attr_1", "zoo_attr_2", "zoo_attr_3", "zoo_attr_4", "nature_attr_1", "nature_attr_2", "nature_attr_3", "nature_attr_4", "amusement_attr_1", "amusement_attr_2", "amusement_attr_3", "amusement_attr_4"], policies: [TourismPromotion], tiles: 1),
        (population: 20000, name: "City", unlocks: ["stadium", "spec_it_cluster_l", "spec_it_cluster_m", "spec_it_cluster_s", "spec_tourism_l", "spec_tourism_m", "spec_tourism_s", "spec_leisure_l", "spec_leisure_m", "spec_leisure_s", "spec_organic_l", "spec_organic_m", "spec_organic_s", "spec_self_sufficient_l", "spec_self_sufficient_m", "spec_self_sufficient_s"], tiles: 1),
        (population: 35000, name: "Big City", unlocks: ["science_museum", "opera_house", "tv_tower"], tiles: 1),
        (population: 60000, name: "Metropolis", unlocks: [], tiles: 1),
        (population: 100000, name: "Megalopolis", unlocks: [], tiles: 1),
    ],
))
